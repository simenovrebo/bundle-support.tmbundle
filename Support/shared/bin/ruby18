#!/bin/sh

# This script is designed for backwards compatibility with bundle items that
# were designed for ruby 1.8. It passes the input along to ruby 1.8 if already
# installed or if needed installs a copy for TextMates exclusive use. This does
# not affect the system ruby version or any other part of the system.
#
# The copy is a universal (arm64 + x86_64) build of ruby 1.8.7-p374 which is
# included with this bundle, see private/ruby18/build.sh.

if [[ -e /System/Library/Frameworks/Ruby.framework/Versions/1.8/usr/bin/ruby ]]; then
	exec /System/Library/Frameworks/Ruby.framework/Versions/1.8/usr/bin/ruby "$@"
fi

RUBY18_HOME=~/Library/Application\ Support/TextMate/Ruby/1.8.7-p374

if [[ ! -e "$RUBY18_HOME/bin/ruby" ]]; then
	rm -f "$RUBY18_HOME" 2>/dev/null # dangling link
	mkdir -p "${RUBY18_HOME%/*}"
	tmp=$(mktemp -d "$RUBY18_HOME.XXXXXX") || exit 1

	# Extract to a unique location and atomically link it into place, so that a failed or concurrent install never leaves a partial copy behind
	if ! /usr/bin/tar -xJmf "$TM_SUPPORT_PATH/private/ruby18/ruby_1.8.7-p374.txz" -C "$tmp" || [[ ! -e "$tmp/1.8.7-p374/bin/ruby" ]] || ! ln -sn "${tmp##*/}/1.8.7-p374" "$RUBY18_HOME" 2>/dev/null; then
		rm -rf "$tmp"
	fi

	if [[ ! -e "$RUBY18_HOME/bin/ruby" ]]; then
		echo >&2 "Unable to install ruby 1.8 from ‘$TM_SUPPORT_PATH/private/ruby18’."
		exit 1
	fi
fi

exec "$RUBY18_HOME/bin/ruby" -r"$TM_SUPPORT_PATH/private/ruby18_fix_loadpath.rb" "$@"
